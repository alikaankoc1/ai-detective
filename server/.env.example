# AI Detective — sunucu ortam değişkenleri
# Bu dosyayı kopyala:  copy .env.example .env
# Gerçek değerleri yalnızca local server/.env içine yaz. Git'e commit etme.

# --- Mevcut ---
PORT=3000
GEMINI_API_KEY=

# --- Supabase (Dashboard → Project Settings → API) ---
# Project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co


SUPABASE_SERVICE_ROLE_KEY=

# Mobil publishable/anon key kök .env içindedir (EXPO_PUBLIC_*), server/.env'de tutulmaz.
# service_role ASLA Expo / EXPO_PUBLIC_* altına konmaz.
