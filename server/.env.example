# AI Detective — sunucu ortam değişkenleri
# Bu dosyayı kopyala:  copy .env.example .env
# Gerçek değerleri yalnızca local server/.env içine yaz. Git'e commit etme.

# --- Mevcut ---
PORT=3000
GEMINI_API_KEY=

# --- Supabase (Dashboard → Project Settings → API) ---
# Project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# service_role (secret) — YALNIZCA sunucu. Mobil / Expo / GitHub'a koyma.
SUPABASE_SERVICE_ROLE_KEY=

# anon / public key — ileride mobil auth için aday; şimdilik sunucuda da opsiyonel.
# Mobil pakete service_role ASLA konmaz. Anon key bile şimdilik mobilde kullanılmıyor
# (oyun API'si Node backend üzerinden).
# SUPABASE_ANON_KEY=
