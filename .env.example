# Expo (mobil) — yalnızca public değerler. Commit etme.
# Dashboard → Project Settings → API
# URL + publishable / anon key (service_role ASLA buraya konmaz)

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend API (zorunlu production / release build'de)
# Development varsayılanı: Android emülatör → http://10.0.2.2:3000
#                         iOS sim / web → http://localhost:3000
# Fiziksel telefon: PC'nin LAN IP'si (aynı Wi‑Fi)
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000
# Production (Play Store / TestFlight): gerçek HTTPS API — localhost KULLANILMAZ
#   EXPO_PUBLIC_API_BASE_URL=https://api.your-domain.com
EXPO_PUBLIC_API_BASE_URL=
