# Expo (mobil) — yalnızca public değerler. Commit etme.
# Dashboard → Project Settings → API
# URL + publishable / anon key (service_role ASLA buraya konmaz)

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opsiyonel: Android fiziksel cihazda host IP, örn. http://192.168.1.10:3000
# Emülatörde varsayılan http://10.0.2.2:3000 kullanılır.
# EXPO_PUBLIC_API_BASE_URL=
